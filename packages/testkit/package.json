  },
  "dependencies": {
    "@pcos/db": "workspace:*",
    "embedded-postgres": "18.4.0-beta.17",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@pcos/config": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "eslint": "^10.11.0",
    "typescript": "6.0.3"
  }
}
