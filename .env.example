# Poker Club OS — Venue Edge Server configuration.
# Copy to .env and fill in. NEVER commit real secrets (spec §89, §88).

# --- core ---------------------------------------------------------------------
NODE_ENV=production
DATABASE_URL=postgres://pcos:change-me@postgres:5432/pcos
# Optional: cross-instance rate limiting and presence. Leave empty to run without Redis.
REDIS_URL=redis://redis:6379

# Public (Internet) URL, used in Telegram buttons and e-mails. Optional.
APP_URL=
# Venue-local URL (split-horizon DNS name resolving to the edge server's LAN IP).
LOCAL_APP_URL=https://poker.club.example
LOCAL_HOSTNAME=poker.club.example
# Browser origins allowed to call the API (comma separated).
ALLOWED_ORIGINS=https://poker.club.example

EDGE_NODE_ID=edge-main-01
VENUE_ID=

# At least 32 random characters: openssl rand -hex 32
SESSION_SECRET=
# Optional separate key for encrypting integration secrets at rest (defaults to a key derived from SESSION_SECRET).
SECRETS_ENCRYPTION_KEY=
SESSION_TTL_HOURS=336
COOKIE_SECURE=true
# Optional fixed first-run setup token; otherwise one is generated and printed on the API console.
SETUP_TOKEN=
PORT=4000
# Only the reverse proxy may set X-Forwarded-For (Docker network of the edge stack).
TRUST_PROXY=loopback,172.16.0.0/12
AUTO_MIGRATE=true

# --- Telegram (optional, never required for live operation) ---------------------------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# long_polling (default, no inbound port needed) or webhook (cloud gateway mode)
TELEGRAM_MODE=long_polling
TELEGRAM_WEBHOOK_SECRET=

# --- optional cloud control plane ------------------------------------------------------
CLOUD_SYNC_ENABLED=false
CLOUD_API_URL=
CLOUD_SYNC_TOKEN=

# WAN probe: any HTTP response from any of these means "Internet available".
WAN_PROBE_URLS=https://api.telegram.org,https://1.1.1.1
WAN_PROBE_INTERVAL_MS=15000

# --- storage & backups ------------------------------------------------------------------
STORAGE_DIR=/data/files
BACKUP_DIR=/data/backups
BACKUP_SCHEDULE_HOURS=6
BACKUP_RETENTION=28
PG_DUMP_PATH=pg_dump
# Optional encrypted off-site copy after each backup, {file} is replaced by the dump path:
# OFFSITE_BACKUP_COMMAND=restic -r s3:https://s3.example.com/pcos-backups backup {file}
OFFSITE_BACKUP_COMMAND=

S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- e-mail (optional) ----------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Poker Club <no-reply@club.example>

SENTRY_DSN=
LOG_LEVEL=info
