{
  "name": "@pcos/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@pcos/core": "workspace:*",
    "@pcos/db": "workspace:*"
  },
  "devDependencies": {
    "@pcos/config": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "^10.11.0",
    "typescript": "6.0.3"
  }
}
